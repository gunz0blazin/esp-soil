{
  "uid": "soil-monitor",
  "title": "Soil Monitor",
  "tags": [
    "soil",
    "esphome"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "board",
        "label": "Stake",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(esphome_sensor_value{board!=\"test-probe\"}, board)",
          "refId": "board"
        },
        "definition": "label_values(esphome_sensor_value{board!=\"test-probe\"}, board)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "description": "One section per probe: the test probe first, then each stake. Short 15-minute window that refreshes every 30 seconds; widen it with the time picker.",
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Test probe: soil moisture",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 101,
      "type": "gauge",
      "title": "Moisture",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "esphome_sensor_value{board=\"test-probe\", name=~\"(?i).*moisture.*\"}",
          "legendFormat": "Moisture",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "green",
                "value": 45
              },
              {
                "color": "blue",
                "value": 85
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto"
      }
    },
