{
  "uid": "soil-monitor",
  "title": "Soil Monitor",
  "tags": [
    "soil",
    "esphome"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 8,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "board",
        "label": "Stake",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"esphome\", board!=\"test-probe\"}, board)",
          "refId": "board"
        },
        "definition": "label_values(up{job=\"esphome\", board!=\"test-probe\"}, board)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "description": "One section per probe: the test probe first, then each stake. Short 15-minute window that refreshes every 30 seconds; widen it with the time picker.",
  "panels": [
    {
      "id": 104,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
