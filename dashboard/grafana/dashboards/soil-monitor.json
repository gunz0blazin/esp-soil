      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "deriv(esphome_sensor_value{board=\"test-probe\", name=~\"(?i).*moisture.*\"}[5m]) * 60",
          "legendFormat": "Moisture",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: %/min",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "text",
                "value": -0.05
              },
              {
                "color": "blue",
                "value": 0.05
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "How fast moisture is changing, in percentage points per minute (5-minute slope). Negative = drying, positive = getting wetter."
