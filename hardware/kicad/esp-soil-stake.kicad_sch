  (wire (pts (xy 127 72.39) (xy 127 74.93)) (stroke (width 0) (type default)) (uuid "e0a53496-02cd-5d0d-a8ee-e90f436aadce"))
  (text "Probe output is ~2.5 V dry / ~1.2 V wet. The C3's ADC tops out near 2.5 V,\nso R1/R2 scale it by 33k/(10k+33k) = 0.767. C1 filters ADC noise.\nCalibrate dry_v / wet_v at the ESP pin (after the divider)." (exclude_from_sim no) (at 147.32 162.56 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e4a2b0d3-8c57-5c3b-8818-75149f28a93e"))
  (text "C2: bulk cap for Wi-Fi current spikes, laid flat." (exclude_from_sim no) (at 111.76 88.9 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "fce0127a-8c05-50b1-98ea-168d73271e29"))
  (text "Mechanical: H1/H2 take the case's locating pins. CASE1 only carries the\ncase 3D model so the 3D viewer shows the board inside the case." (exclude_from_sim no) (at 45.72 195.58 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "946a0a45-2cc4-5687-98ce-c17b818ee114"))
