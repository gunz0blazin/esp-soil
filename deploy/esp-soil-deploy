#!/bin/sh
# Pull the repo and run deploy/site.yml with ansible-pull.
#   esp-soil-deploy           pull the branch and run the deploy (what the timer runs every
#                             5 minutes). Always runs: with nothing new it changes nothing,
#                             and a failed deploy is retried on the next run by itself.
#   --force                   same thing; still accepted from before deploys always ran
#   add -vv or -vvv for more detail, --quiet for task names only
# Settings: /etc/esp-soil/deploy.env (REPO_URL, BRANCH). Installed by bootstrap.sh and
# kept up to date by every deploy.
set -eu

REPO_URL=https://github.com/gunz0blazin/esp-soil.git
BRANCH=main
CHECKOUT=/opt/esp-soil/src
[ -r /etc/esp-soil/deploy.env ] && . /etc/esp-soil/deploy.env

if [ "$(id -u)" -ne 0 ]; then
  echo "Run as root: sudo esp-soil-deploy $*" >&2
  exit 1
fi

VERBOSE=-v
for arg in "$@"; do
  case "$arg" in
    --force) ;;
    -v*)     VERBOSE=$arg ;;          # -vv / -vvv for even more detail
    --quiet) VERBOSE= ;;
    *) echo "Usage: esp-soil-deploy [--force] [-vv|-vvv|--quiet]" >&2; exit 1 ;;
  esac
done

# Show each task's output (Docker, rsync, promtool...) as readable YAML
# instead of one-line JSON. Same detail lands in journalctl for timer runs.
export ANSIBLE_CALLBACK_RESULT_FORMAT=yaml
export ANSIBLE_FORCE_COLOR="${ANSIBLE_FORCE_COLOR:-$([ -t 1 ] && echo 1 || echo 0)}"

exec 9>/run/esp-soil-deploy.lock
if ! flock -n 9; then
  echo "Another deploy is already running."
  exit 0
fi

# --limit localhost: otherwise ansible-pull also looks for this machine's hostname
# in the inventory and warns that it can't find it.
ansible-pull --url "$REPO_URL" --checkout "$BRANCH" --directory "$CHECKOUT" \
  --clean --inventory localhost, --limit localhost $VERBOSE deploy/site.yml
