# The site's network plan for the Pi.
# The bootstrap on main saves these on the Pi for its next boot. Test boxes (any
# other branch) ignore this file and keep their own address.
# The stakes' addresses are in firmware/stakes/ (stake_ip); the GitHub checks make
# sure the Pi is on the stakes' network and clashes with none of them.
PI_STATIC_IP=10.42.0.10/24
PI_GATEWAY=10.42.0.1
PI_DNS=10.42.0.1
